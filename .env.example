PORT=3000

# Yahoo OAuth App (https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/auth/callback

# Your league and team keys (from Yahoo Fantasy URLs)
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=

# Gemini (Google AI Studio) API key
GEMINI_API_KEY=

# Optional: change local timezone for scheduler
TZ=America/Los_Angeles

# Automation
AUTO_ENABLE=true
LINEUP_CRON=*/10 * * * *
WAIVER_CRON=5 3 * * *
TRADE_CRON=0 9 * * *
DAILY_CRON=0 8 * * *
NEWS_POLL_MIN=5
NEWS_PROVIDER=sleeper

# Manager configuration (overrides config/app.config.json)
FAAB_BUDGET=100
MGR_AGGRESSIVENESS=0.6
MGR_INJURY_RISK=0.4
