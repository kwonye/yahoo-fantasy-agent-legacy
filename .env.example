# Yahoo Fantasy Sports API
# Client ID/Secret are now managed via the web dashboard and stored securely.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Bot Configuration (Autonomous defaults)
BOT_RISK_TOLERANCE=MODERATE
BOT_TRADING_ENABLED=true
BOT_WAIVER_WIRE_ENABLED=true
BOT_MAX_WAIVER_CLAIMS=3
BOT_TRADE_THRESHOLD=0
BOT_RUN_HOUR=9
BOT_RUN_MINUTE=0
BOT_RUN_ON_START=true
# IMPORTANT: Set to true for live writes. Requires YAHOO_XML_WRITE=1.
APPLY_CHANGES=true

# Yahoo XML writes are required for actual roster/waiver/trade changes
YAHOO_XML_WRITE=1

# Feature toggles
KICKOFF_CHECKS_ENABLED=1
WAIVER_AUTOMATION_ENABLED=1
TRADES_AUTOMATION_ENABLED=1

# Optional: control waiver scheduler timing (fallbacks to league profile if present)
# WAIVER_DAY=2        # 0=Sun ... 6=Sat (default Tue)
# WAIVER_HOUR=7
# WAIVER_MINUTE=0

# Optional safety/debug
# Cap daily Gemini calls (default 50) to avoid quota overuse
# MAX_GEMINI_CALLS_PER_DAY=40
# Enable verbose Yahoo debug dumps under ./logs
# DEBUG_YAHOO=1

# Secure Config Storage
# Provide a stable encryption key for local encrypted credential storage
# Recommended: a 32-byte hex string (e.g., output of `openssl rand -hex 32`)
CONFIG_ENCRYPTION_KEY=change_me_please
# Optional: directory to store encrypted files (defaults to ./.secure)
# CONFIG_DIR=.secure

# Yahoo OAuth Optional Bootstrap (leave blank normally)
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=

# OAuth Redirect URI (must match your Yahoo app registration)
# If you terminate TLS locally, use https; otherwise use http.
# The server supports both /auth/callback and /oauth/callback.
REDIRECT_URI=https://localhost:3000/auth/callback

# Credential source preference (optional)
# By default, the service prefers credentials saved in the secure store (UI)
# over environment variables. To force using env vars, set either of:
# YAHOO_CRED_SOURCE=env
# PREFER_ENV_CREDS=1

# Optional HTTPS listener (for https://localhost:3443 callbacks)
# Set to your local dev certificate paths to enable HTTPS.
ENABLE_HTTPS=0
HTTPS_PORT=3000
SSL_CERT_PATH=
SSL_KEY_PATH=

# Demo keys for fetching data (required for running the bot)
LEAGUE_KEY=
TEAM_KEY=
