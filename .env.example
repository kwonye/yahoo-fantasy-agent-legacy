PORT=3000

# Yahoo OAuth App (https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
## Must be HTTPS per Yahoo app policy. Default supports local HTTPS on 3443.
## - Default local HTTPS:  https://localhost:3443/auth/callback
## - Using a tunnel:       https://<your-subdomain>.ngrok.io/auth/callback
YAHOO_REDIRECT_URI=https://localhost:3443/auth/callback

# Optional one-time env auth code (bypasses browser redirect flow)
# Obtain an authorization code from Yahoo and set it here to exchange on startup.
YAHOO_AUTH_CODE=

# Your league and team keys (from Yahoo Fantasy URLs)
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=

# Gemini (Google AI Studio) API key
GEMINI_API_KEY=

# Optional: change local timezone for scheduler
TZ=America/Los_Angeles

# Automation
AUTO_ENABLE=true
LINEUP_CRON=*/10 * * * *
WAIVER_CRON=5 3 * * *
TRADE_CRON=0 9 * * *
DAILY_CRON=0 8 * * *
NEWS_POLL_MIN=5
NEWS_PROVIDER=sleeper

# Ports
PORT=3000
HTTPS_PORT=3443

# HTTPS options
# 1) Self-signed TLS (default when redirect URI is https://localhost:...)
#    Set ENABLE_SELF_SIGNED_TLS=true to force generation.
# 2) Custom certs: set paths below.
ENABLE_SELF_SIGNED_TLS=true
SSL_CERT_PATH=
SSL_KEY_PATH=
