# Yahoo Fantasy Sports API & Gemini
# Save Yahoo Client ID/Secret and the Gemini API key via the dashboard (stored encrypted in .secure/)

# Google Gemini API key and model are managed via the dashboard (stored encrypted)

# Secure Config Storage
# Provide a stable encryption key for local encrypted credential storage
# Recommended: a 32-byte hex string (e.g., output of `openssl rand -hex 32`)
CONFIG_ENCRYPTION_KEY=change_me_please
# Optional: directory to store encrypted files (defaults to ./.secure)
# CONFIG_DIR=.secure



# Credential source preference (optional)
# By default, the service prefers credentials saved in the secure store (UI)
# over environment variables. To force using env vars, set either of:
# YAHOO_CRED_SOURCE=env
# PREFER_ENV_CREDS=1

# Demo keys for fetching data (required for running the bot)
