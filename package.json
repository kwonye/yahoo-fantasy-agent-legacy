{
  "name": "fantasy-football-bot",
  "version": "1.0.0",
  "description": "Automated fantasy football bot using Yahoo Fantasy Sports API and Gemini AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "bot": "ts-node src/tools/runBot.ts once",
    "bot:schedule": "ts-node src/tools/runBot.ts schedule",
    "demo": "ts-node src/tools/demoYahoo.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,html,json}'"
  },
  "engines": {
    "node": ">=18"
  },
  "vercel": {
    "build": {
      "env": {}
    }
  },
  "keywords": [
    "fantasy-football",
    "automation",
    "yahoo-api",
    "gemini-ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "luxon": "^3.5.0",
    "next": "^15.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
