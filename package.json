{
  "name": "fantasy-football-bot",
  "version": "1.0.0",
  "description": "Automated fantasy football bot using Yahoo Fantasy Sports API and Gemini AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "next build && tsc",
    "vercel-build": "next build && npm run build",
    "start": "next start",
    "dev": "next dev",
    "bot": "ts-node src/tools/runBot.ts once",
    "bot:schedule": "ts-node src/tools/runBot.ts schedule",
    "demo": "ts-node src/tools/demoYahoo.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
  "web": "node dist/web/server.js > logs/server_output.log 2>&1",
    "web:https": "ENABLE_HTTPS=1 SSL_CERT_PATH=config/certs/cert.pem SSL_KEY_PATH=config/certs/key.pem ts-node src/web/server.ts",
    "web:dev": "nodemon --signal SIGTERM --ext ts,html,json --watch src --watch public --ignore logs --exec \"npx ts-node src/web/server.ts\"",
    "web:dev:https": "ENABLE_HTTPS=1 SSL_CERT_PATH=config/certs/cert.pem SSL_KEY_PATH=config/certs/key.pem nodemon --signal SIGTERM --ext ts,html,json --watch src --watch public --ignore logs --exec \"npx ts-node src/web/server.ts\""
  },
  "vercel": {
    "build": {
      "env": {}
    }
  },
  "keywords": [
    "fantasy-football",
    "automation",
    "yahoo-api",
    "gemini-ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.19.2",
    "luxon": "^3.5.0",
    "serverless-http": "^3.2.0"
  }
}
